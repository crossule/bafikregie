# ============================================
# BAFIK Medical Congress — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.

# Site URL (swap when domain is ready)
NEXT_PUBLIC_SITE_URL=https://bafik.com

# WhatsApp — full international format, no + or spaces
# Example: 2250700000000 (Côte d'Ivoire)
NEXT_PUBLIC_WHATSAPP_NUMBER=22500000000

# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=contact@bafik.com

# Phone (display only)
NEXT_PUBLIC_PHONE=+225 XX XX XX XX XX

# Social links (optional — leave empty to hide)
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_INSTAGRAM=
